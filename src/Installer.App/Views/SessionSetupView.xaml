<UserControl x:Class="Installer.App.Views.SessionSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Style="{StaticResource Card}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Thông tin máy cài đặt" Style="{StaticResource Title}"/>
                <TextBlock Text="Nhập đơn vị và xác nhận tên máy trước khi tiếp tục." Style="{StaticResource Muted}" Margin="0,4,0,20"/>

                <TextBlock Text="Tên đơn vị" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UnitBox" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,2"/>
                <TextBlock Text="Viết liền không dấu, in hoa chữ cái đầu mỗi từ. Ví dụ: LamThao, HoaBinh" Style="{StaticResource Muted}"/>
                <TextBlock Text="{Binding UnitPreview}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,2,0,0"/>

                <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Margin="0,18,0,14"/>

                <TextBlock Style="{StaticResource FieldLabel}">
                    <Run Text="Tên máy hiện tại:"/> <Run Text="{Binding CurrentName, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock Text="{Binding PendingName, StringFormat='Tên mới sau khi khởi động lại: {0}'}" Foreground="{StaticResource WarnBrush}"
                           FontSize="12" Margin="0,2,0,0"
                           Visibility="{Binding PendingName, Converter={StaticResource NullToCollapsed}}"/>
                <TextBlock Text="Máy đã tham gia domain: đổi tên cần tài khoản domain nên không làm được ở đây." Style="{StaticResource Muted}"
                           Margin="0,4,0,0" Visibility="{Binding DomainJoined, Converter={StaticResource BoolToVisibility}}"/>

                <CheckBox Content="Đổi tên máy" IsChecked="{Binding WantRename}" IsEnabled="{Binding CanRename}" Margin="0,10,0,0"/>
                <StackPanel Margin="24,8,0,0" Visibility="{Binding WantRename, Converter={StaticResource BoolToVisibility}}">
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
                    <TextBlock Margin="0,2,0,0" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Text" Value="{Binding NameLengthText}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NameTooLong}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding NameHint}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                    <TextBlock Text="Tên mới có hiệu lực sau khi khởi động lại máy." Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>

                <Border Background="{StaticResource SubtleBrush}" CornerRadius="6" Padding="12,10" Margin="0,16,0,0"
                        Visibility="{Binding BitLockerNotice, Converter={StaticResource NullToCollapsed}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Top" Margin="0,1,10,0"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{Binding BitLockerNotice}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,14,0,0"
                           Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}"/>
                <Button Content="Tiếp tục" Command="{Binding ContinueCommand}" IsDefault="True" Margin="0,18,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
