<UserControl x:Class="Installer.App.Views.SecureBootBlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Style="{StaticResource Card}" Width="620" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource WarnBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Secure Boot đang BẬT — chưa thể cài đặt" Style="{StaticResource Title}" FontSize="20"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Background="{StaticResource WarnBgBrush}" CornerRadius="6" Padding="14,12" Margin="0,8,0,16">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}"/>
                </Border>

                <TextBlock Text="Hướng dẫn tắt Secure Boot" Style="{StaticResource FieldLabel}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding Guide}" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="20"/>

                <TextBlock Text="{Binding Status}" Style="{StaticResource ErrorText}" Margin="0,0,0,10"
                           Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Khởi động lại máy" Command="{Binding RestartCommand}" Padding="22,10" FontWeight="SemiBold"/>
                    <Button Content="Kiểm tra lại" Command="{Binding RecheckCommand}" Style="{StaticResource SecondaryButton}"
                            Padding="16,10" Margin="10,0,0,0"/>
                    <Button Content="Thoát" Command="{Binding ExitCommand}" Style="{StaticResource SecondaryButton}"
                            Padding="16,10" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
