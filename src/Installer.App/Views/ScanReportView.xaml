<UserControl x:Class="Installer.App.Views.ScanReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Installer.App.ViewModels"
             xmlns:scan="clr-namespace:Installer.Core.Scanning;assembly=Installer.Core">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: title + status on the left, the one primary action on the right -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Title}" TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" ToolTip="{Binding Title}"/>
                <TextBlock Text="{Binding CurrentStep}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}"
                             BorderThickness="0" Background="{StaticResource BorderBrushSoft}"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,6,0,0"
                           Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding ContinueText}" Command="{Binding ContinueCommand}"
                    VerticalAlignment="Top" MinWidth="140"/>
        </Grid>

        <!-- Overview strip -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Overview}" Margin="0,0,-10,16" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:OverviewItem}">
                    <Border Style="{StaticResource OverviewCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource OverviewLabel}"/>
                            <TextBlock Text="{Binding Value}" Style="{StaticResource OverviewValue}" ToolTip="{Binding Value}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TabControl Grid.Row="2" Style="{StaticResource ReportTabs}">

            <!-- Máy tính: compact identity of the machine -->
            <TabItem Header="Máy tính" Style="{StaticResource ReportTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding HardwareRows}" Focusable="False" MaxWidth="760" HorizontalAlignment="Left">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HardwareRow}">
                                <Border BorderBrush="{StaticResource SubtleBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Label}" Value="Lỗi quét">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- Thiết bị ngoại vi: grouped, collapsed by default, searchable -->
            <TabItem Header="Thiết bị ngoại vi" Style="{StaticResource ReportTab}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" Style="{StaticResource SearchBox}" Tag="Tìm theo tên hoặc mã thiết bị"
                             Text="{Binding DeviceSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                             Width="380" Height="36" HorizontalAlignment="Left" Margin="0,0,0,10"
                             AutomationProperties.Name="Tìm thiết bị"/>
                    <TextBlock Grid.Row="1" Text="Không có thiết bị nào khớp với từ tìm kiếm." Style="{StaticResource Muted}"
                               FontSize="14" Margin="8,8,0,0"
                               Visibility="{Binding NoDeviceMatches, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Grid.Row="1" Text="Không phát hiện thiết bị ngoại vi nào." FontSize="14" Margin="8,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding PeripheralGroups.Count}" Value="0"/>
                                            <Condition Binding="{Binding IsScanning}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TreeView Grid.Row="2" Style="{StaticResource PeripheralTree}" ItemsSource="{Binding PeripheralGroups}"
                              ItemContainerStyle="{StaticResource GroupTreeItem}">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:PeripheralGroup}" ItemsSource="{Binding Items}"
                                                      ItemContainerStyle="{StaticResource DeviceTreeItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource SectionHeading}"/>
                                    <Border Grid.Column="1" Style="{StaticResource CountBadge}">
                                        <TextBlock Text="{Binding Count}" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type scan:DeviceInfo}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="{Binding DeviceId}" Style="{StaticResource Muted}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceId}"/>
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                    <!-- USB storage history: devices Windows still remembers -->
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Lịch sử thiết bị lưu trữ" Style="{StaticResource SectionHeading}" Margin="0,0,0,8"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding UsbRows}" MaxHeight="190">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NoUsbHistory}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Thiết bị" Binding="{Binding Name}" Width="*" MinWidth="200"/>
                                <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" Width="180"/>
                                <DataGridTextColumn Header="Lần đầu" Binding="{Binding First}" Width="140"/>
                                <DataGridTextColumn Header="Lần gần nhất" Binding="{Binding Last}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="1" Text="Không tìm thấy dữ liệu" Style="{StaticResource Muted}" FontSize="14" Margin="8,0,0,0"
                                   Visibility="{Binding NoUsbHistory, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Mạng -->
            <TabItem Header="Mạng" Style="{StaticResource ReportTab}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding InternetText}" Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding NetworkRows}"
                              EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên mạng" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Loại" Binding="{Binding Kind}" Width="100"/>
                            <DataGridTextColumn Header="Lần đầu" Binding="{Binding First}" Width="140"/>
                            <DataGridTextColumn Header="Lần cuối" Binding="{Binding Last}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Bản quyền: Windows and Office side by side -->
            <TabItem Header="Bản quyền" Style="{StaticResource ReportTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Windows" Style="{StaticResource SectionHeading}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource LicenseBox}">
                                <TextBlock Text="{Binding WindowsLicenseText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WindowsIsCracked}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Office" Style="{StaticResource SectionHeading}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource LicenseBox}">
                                <TextBlock Text="{Binding OfficeLicenseText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OfficeIsCracked}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- File từ khóa -->
            <TabItem Header="File từ khóa" Style="{StaticResource ReportTab}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding KeywordWarning}" Style="{StaticResource ErrorText}" Margin="0,0,0,10"
                               Visibility="{Binding KeywordWarning, Converter={StaticResource NullToCollapsed}}"/>
                    <TextBlock Grid.Row="1" Text="Không có file nào chứa từ khóa." FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding KeywordFiles.Count}" Value="0"/>
                                            <Condition Binding="{Binding IsScanning}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListBox Grid.Row="2" ItemsSource="{Binding KeywordFiles}" Style="{StaticResource PlainList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
