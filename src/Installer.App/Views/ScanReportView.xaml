<UserControl x:Class="Installer.App.Views.ScanReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Báo cáo quét máy" Style="{StaticResource Title}"/>
            <TextBlock Text="{Binding CurrentStep}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}"
                         BorderThickness="0" Background="{StaticResource BorderBrushSoft}">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                       Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Phần cứng">
                <DataGrid ItemsSource="{Binding HardwareRows}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mục" Binding="{Binding Label}" Width="200"/>
                        <DataGridTextColumn Header="Giá trị" Binding="{Binding Value}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Lịch sử mạng">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding InternetText}" Margin="12,10,12,10"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding NetworkRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Loại" Binding="{Binding Kind}" Width="100"/>
                            <DataGridTextColumn Header="Lần đầu" Binding="{Binding First}" Width="150"/>
                            <DataGridTextColumn Header="Lần cuối" Binding="{Binding Last}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Bản quyền">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Windows" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource LicenseBox}">
                            <TextBlock Text="{Binding WindowsLicenseText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowsIsCracked}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="Office" FontWeight="SemiBold" Margin="0,8,0,6"/>
                        <Border Style="{StaticResource LicenseBox}">
                            <TextBlock Text="{Binding OfficeLicenseText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OfficeIsCracked}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="File từ khóa">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding KeywordWarning}" Style="{StaticResource ErrorText}" Margin="12,10"
                               Visibility="{Binding KeywordWarning, Converter={StaticResource NullToCollapsed}}"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding KeywordFiles}" BorderThickness="0" FontFamily="Consolas"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Content="Tiếp tục" Command="{Binding ContinueCommand}"
                HorizontalAlignment="Right" Margin="0,16,0,0" MinWidth="140"/>
    </Grid>
</UserControl>
