<UserControl x:Class="Installer.App.Views.PackageListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Installer.App.ViewModels"
             xmlns:ver="clr-namespace:Installer.Core.Versioning;assembly=Installer.Core">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: title on the left; toolbar on the right, primary action last -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Phần mềm được phép cài" Style="{StaticResource Title}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="Tick các phần mềm cần cài rồi bấm nút cài, hoặc cài từng phần mềm ở cuối dòng." Style="{StaticResource Muted}"
                           Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,6,0,0"
                           Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Xem lại báo cáo quét" Command="{Binding ViewScanCommand}" Style="{StaticResource SecondaryButton}"
                        Padding="14,8" Margin="0,0,8,0"/>
                <Button Content="Quản trị" Command="{Binding OpenAdminCommand}" Style="{StaticResource SecondaryButton}"
                        Padding="14,8"
                        Visibility="{Binding CanOpenAdmin, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Style="{StaticResource ReportTabs}" ItemContainerStyle="{StaticResource ReportTab}">
        <TabItem Header="Tất cả phần mềm">
            <!-- Negative margin cancels the tab template's content padding so the list runs edge to edge -->
            <Grid Margin="-20,-14" Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column headers (same widths as the row template) -->
                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="3,9,12,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="196"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Actions"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}" IsChecked="{Binding AllInstallableSelected, Mode=TwoWay}"
                                  AutomationProperties.Name="Chọn tất cả phần mềm có thể cài"/>
                        <TextBlock Grid.Column="2" Text="Phần mềm" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Grid.Column="3" Text="Trên máy" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Grid.Column="4" Text="Trạng thái" Style="{StaticResource ColumnHeader}"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1" Text="Kho chưa có phần mềm nào." FontSize="14" Margin="20,16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" ItemContainerStyle="{StaticResource PackageRowItem}"
                         BorderThickness="0" Background="Transparent" Margin="0,0,0,6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" KeyboardNavigation.TabNavigation="Continue"
                         AutomationProperties.Name="Danh sách phần mềm">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PackageRowViewModel}">
                            <Grid Margin="0,8,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="196"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Actions"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding Allowed}"
                                          AutomationProperties.Name="{Binding Name, StringFormat='Chọn {0}'}"
                                          ToolTip="{Binding ReasonsText}" ToolTipService.ShowOnDisabled="True">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource RowCheck}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Allowed}" Value="True">
                                                    <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>

                                <Image Grid.Column="1" Width="48" Height="48" HorizontalAlignment="Left"
                                       Source="{Binding Icon, Converter={StaticResource PackageIcon}}"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <TextBlock Text="{Binding PackageVersion, StringFormat='Kho {0}'}" Style="{StaticResource Muted}"
                                               Margin="0,1,0,0" TextWrapping="NoWrap"/>
                                    <TextBlock Text="{Binding ReasonsText}" Foreground="{StaticResource DangerBrush}" FontSize="12"
                                               Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ReasonsText}"
                                               Visibility="{Binding ReasonsText, Converter={StaticResource NullToCollapsed}}"/>
                                </StackPanel>

                                <!-- Installed program: its own icon when Windows records one (HKLM only) -->
                                <Grid Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Source="{Binding InstalledIcon, Converter={StaticResource InstalledIcon}}"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <Trigger Property="Source" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock Grid.Column="1" Text="{Binding InstalledVersion}" VerticalAlignment="Center"
                                               ToolTip="{Binding InstalledVersion}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Version status pill -->
                                <Border Grid.Column="4" Margin="0,0,12,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static ver:VersionStatus.Older}">
                                                    <Setter Property="Background" Value="{StaticResource AccentPillBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static ver:VersionStatus.Equal}">
                                                    <Setter Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static ver:VersionStatus.Newer}">
                                                    <Setter Property="Background" Value="{StaticResource WarnBgBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static ver:VersionStatus.Older}">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static ver:VersionStatus.Equal}">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static ver:VersionStatus.Newer}">
                                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Actions -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Cài đặt" Command="{Binding InstallCommand}" Style="{StaticResource RowButton}"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Cài đặt {0}'}"/>
                                    <ItemsControl ItemsSource="{Binding Docs}" Focusable="False" Margin="6,0,0,0"
                                                  Visibility="{Binding HasDocs, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="Hướng dẫn" ToolTip="{Binding}" Style="{StaticResource SecondaryButton}"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DataContext.OpenDocCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Gỡ" Command="{Binding UninstallCommand}" Foreground="{StaticResource DangerBrush}"
                                            Margin="6,0,0,0" ToolTip="{Binding UninstallToolTip}" ToolTipService.ShowOnDisabled="True"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Gỡ cài đặt {0}'}"
                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanUninstall}" Value="True">
                                                        <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </TabItem>

        <TabItem Header="Bộ cài đặt">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="-20,-14">
                <ItemsControl ItemsSource="{Binding BundleCards}" Margin="20,14" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BundleCardViewModel}">
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,2,0,8"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding Description, Converter={StaticResource NullToCollapsed}}"/>
                                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding Name}" MinWidth="180"/>
                                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" MinWidth="150"/>
                                                        <TextBlock Text="{Binding SkipReason}" Foreground="{StaticResource WarnBrush}" FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding SkipReason, Converter={StaticResource NullToCollapsed}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Cài bộ này" Command="{Binding InstallCommand}" VerticalAlignment="Top"
                                            Padding="18,8" AutomationProperties.Name="{Binding Name, StringFormat='Cài bộ {0}'}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </TabItem>
        </TabControl>

        <!-- Bottom action bar: only while at least one row is ticked -->
        <Border Grid.Row="2" Margin="0,12,0,0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1" CornerRadius="8" Padding="16,10"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SelectedCountText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Hủy chọn" Command="{Binding ClearSelectionCommand}"
                        Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="{Binding InstallSelectedLabel}" Command="{Binding InstallSelectedCommand}"
                        MinWidth="200" Padding="18,8"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
