<UserControl x:Class="Installer.App.Views.PackageListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Installer.App.ViewModels"
             xmlns:ver="clr-namespace:Installer.Core.Versioning;assembly=Installer.Core">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: title on the left; toolbar on the right, primary action last -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2F7BE8" Offset="0"/>
                                <GradientStop Color="#1A4FA0" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="28" FontWeight="Bold" TextWrapping="NoWrap">
                            <Run Text="Secure" Foreground="{StaticResource TextBrush}"/><Run Text="Installer" Foreground="{StaticResource AccentBrush}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="NoWrap">
                            <Run Text="Phát triển bởi"/> <Run Text="DungCY" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding MachineText}" FontSize="12" Margin="0,2,0,0" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding MachineText}"
                                   Visibility="{Binding MachineText, Converter={StaticResource NullToCollapsed}}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,6,0,0"
                           Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding RescanCommand}" Style="{StaticResource TileButton}" Margin="0,0,10,0"
                        AutomationProperties.Name="Quét lại máy" ToolTip="Quét lại toàn bộ máy (mất vài phút)"
                        Visibility="{Binding CanRescan, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Quét lại" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ViewScanCommand}" Style="{StaticResource TileButton}" Margin="0,0,10,0"
                        AutomationProperties.Name="Xem lại báo cáo quét">
                    <StackPanel>
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Báo cáo quét" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenAdminCommand}" Style="{StaticResource TileButton}"
                        AutomationProperties.Name="Quản trị"
                        Visibility="{Binding CanOpenAdmin, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Quản trị" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Style="{StaticResource ReportTabs}" ItemContainerStyle="{StaticResource ReportTab}">
        <TabItem Header="Tất cả phần mềm">
            <!-- Negative margin cancels the tab template's content padding so the list runs edge to edge -->
            <Grid Margin="-20,-14" Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column headers (same widths as the row template) -->
                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="3,9,12,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Install"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Uninstall"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Docs"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}" IsChecked="{Binding AllInstallableSelected, Mode=TwoWay}"
                                  AutomationProperties.Name="Chọn tất cả phần mềm có thể cài"/>
                        <TextBlock Grid.Column="2" Text="Phần mềm" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Grid.Column="3" Text="Trạng thái trên máy" Style="{StaticResource ColumnHeader}"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1" Text="Kho chưa có phần mềm nào." FontSize="14" Margin="20,16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" ItemContainerStyle="{StaticResource PackageRowItem}"
                         BorderThickness="0" Background="Transparent" Margin="0,0,0,6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" KeyboardNavigation.TabNavigation="Continue"
                         AutomationProperties.Name="Danh sách phần mềm">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PackageRowViewModel}">
                            <Grid Margin="0,8,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Install"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Uninstall"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Docs"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding Allowed}"
                                          AutomationProperties.Name="{Binding Name, StringFormat='Chọn {0}'}"
                                          ToolTip="{Binding ReasonsText}" ToolTipService.ShowOnDisabled="True">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource RowCheck}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Allowed}" Value="True">
                                                    <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>

                                <Image Grid.Column="1" Width="48" Height="48" HorizontalAlignment="Left"
                                       Source="{Binding Icon, Converter={StaticResource PackageIcon}}"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <TextBlock Text="{Binding PackageVersion}" Style="{StaticResource Muted}"
                                               Margin="0,1,0,0" TextWrapping="NoWrap"/>
                                    <TextBlock Text="{Binding ReasonsText}" Foreground="{StaticResource DangerBrush}" FontSize="12"
                                               Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ReasonsText}"
                                               Visibility="{Binding ReasonsText, Converter={StaticResource NullToCollapsed}}"/>
                                </StackPanel>

                                <!-- Status on this machine: pill, installed version underneath -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Border HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static ver:VersionStatus.Older}">
                                                    <Setter Property="Background" Value="{StaticResource AccentPillBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static ver:VersionStatus.Equal}">
                                                    <Setter Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static ver:VersionStatus.Newer}">
                                                    <Setter Property="Background" Value="{StaticResource WarnBgBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static ver:VersionStatus.Older}">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static ver:VersionStatus.Equal}">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static ver:VersionStatus.Newer}">
                                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding InstalledVersion, StringFormat='Trên máy: {0}'}" Style="{StaticResource Muted}"
                                           Margin="2,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding InstalledVersion}"
                                           Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>

                                <!-- Actions: install, uninstall and guides each get their own column -->
                                    <Button Grid.Column="4" Content="Cài đặt" Command="{Binding InstallCommand}" ToolTipService.ShowOnDisabled="True"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Cài đặt {0}'}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RowButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NeedsInstall}" Value="False">
                                                        <Setter Property="ToolTip" Value="Máy đã có bản này hoặc mới hơn"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <ItemsControl Grid.Column="6" ItemsSource="{Binding Docs}" Focusable="False" Margin="8,0,0,0" VerticalAlignment="Center"
                                                  Visibility="{Binding HasDocs, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="Hướng dẫn" ToolTip="{Binding}" Style="{StaticResource SecondaryButton}"
                                                        Margin="0,1"
                                                        Command="{Binding DataContext.OpenDocCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Grid.Column="5" Content="Gỡ" Command="{Binding UninstallCommand}" Foreground="{StaticResource DangerBrush}"
                                            Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding UninstallToolTip}" ToolTipService.ShowOnDisabled="True"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Gỡ cài đặt {0}'}"
                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanUninstall}" Value="True">
                                                        <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </TabItem>

        <TabItem Header="Bộ cài đặt">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="-20,-14">
                <ItemsControl ItemsSource="{Binding BundleCards}" Margin="20,14" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BundleCardViewModel}">
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Header: chevron + name/summary toggles the list; install button on the right -->
                                    <Grid Margin="6,6,16,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton x:Name="Toggle" Style="{StaticResource GroupHeaderToggle}" Margin="0,0,16,0"
                                                      AutomationProperties.Name="{Binding Name, StringFormat='Xem danh sách bộ {0}'}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Muted}" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <Button Grid.Column="1" Content="Cài đặt" Command="{Binding InstallCommand}" VerticalAlignment="Center"
                                                Padding="18,8" AutomationProperties.Name="{Binding Name, StringFormat='Cài đặt bộ {0}'}"/>
                                    </Grid>

                                    <!-- Item table, shown when expanded -->
                                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0"
                                            Visibility="{Binding IsChecked, ElementName=Toggle, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Margin="16,4,16,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="40"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="170"/>
                                                                <ColumnDefinition Width="2*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Image Width="28" Height="28" HorizontalAlignment="Left"
                                                                   Source="{Binding Icon, Converter={StaticResource PackageIcon}}"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Version}" Style="{StaticResource Muted}"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="2" Style="{StaticResource Pill}" HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource MutedBrush}" TextWrapping="NoWrap"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                        <Setter Property="Text" Value="{Binding SkipReason}"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SkipReason}" Value="{x:Null}">
                                                                                <Setter Property="Text" Value="✓ Sẽ được cài"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </TabItem>
        </TabControl>

        <!-- Bottom action bar: only while at least one row is ticked -->
        <Border Grid.Row="2" Margin="0,12,0,0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1" CornerRadius="8" Padding="16,10"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SelectedCountText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Hủy chọn" Command="{Binding ClearSelectionCommand}"
                        Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="{Binding InstallSelectedLabel}" Command="{Binding InstallSelectedCommand}"
                        MinWidth="200" Padding="18,8"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
