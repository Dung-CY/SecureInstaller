<Window x:Class="Installer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Installer.App.ViewModels"
        xmlns:v="clr-namespace:Installer.App.Views"
        Title="SecureInstaller" Width="960" Height="680" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <v:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanReportViewModel}">
            <v:ScanReportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PackageListViewModel}">
            <v:PackageListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QueueInstallViewModel}">
            <v:QueueInstallView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminViewModel}">
            <v:AdminView/>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1" Padding="16,6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding VaultInfo}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ReadOnlyNotice}" Foreground="{StaticResource DangerBrush}"/>
                <TextBlock Text="{Binding VaultInfo}" Style="{StaticResource Muted}"/>
            </DockPanel>
        </Border>
        <ContentControl Content="{Binding Current}"/>
    </DockPanel>
</Window>
