<UserControl x:Class="Installer.App.Views.QueueInstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Installer.App.ViewModels">
    <UserControl.Resources>
        <!-- Status colour per queue item tone -->
        <Style x:Key="ToneText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="ok"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="error"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="active"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToneDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="#B4BCC8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="ok"><Setter Property="Fill" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn"><Setter Property="Fill" Value="{StaticResource WarnBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="error"><Setter Property="Fill" Value="{StaticResource DangerBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="active"><Setter Property="Fill" Value="{StaticResource AccentBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,20">
        <Border Style="{StaticResource Card}" Padding="0" Width="600" MaxWidth="720" HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: what is running, how far through the queue -->
                <StackPanel Grid.Row="0" Margin="24,20,24,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Title}" TextWrapping="NoWrap"/>
                        <Border Grid.Column="1" Style="{StaticResource CountBadge}" Padding="12,3">
                            <TextBlock Text="{Binding Header}" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                        </Border>
                    </Grid>

                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding CurrentItem.Name, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="{Binding CurrentItem.Version, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Step}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        <ProgressBar Height="6" Margin="0,10,0,0" Minimum="0" Maximum="100"
                                     Value="{Binding Percent, Mode=OneWay, TargetNullValue=0}"
                                     IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                     Foreground="{StaticResource AccentBrush}" BorderThickness="0"
                                     Background="{StaticResource SubtleBrush}"
                                     AutomationProperties.Name="Tiến độ gói đang chạy"/>
                    </StackPanel>

                    <!-- Result banner once the whole queue has finished -->
                    <Border CornerRadius="6" Padding="14,10" Margin="0,12,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasProblems}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WarnBgBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding Step}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Result}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Per-item results -->
                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,1">
                    <ListBox ItemsSource="{Binding Items}" Style="{StaticResource PlainList}" MaxHeight="300" Padding="24,4"
                             AutomationProperties.Name="Kết quả từng gói">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:QueueItem}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Source="{Binding Icon, Converter={StaticResource PackageIcon}}"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding Version, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}" FontSize="12"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource ToneDot}"/>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource ToneText}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,14,24,18">
                    <Button Content="Hủy" Command="{Binding CancelCommand}" Padding="18,8" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Quay lại" Command="{Binding BackCommand}" MinWidth="120"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
