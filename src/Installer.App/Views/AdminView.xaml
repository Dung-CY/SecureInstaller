<UserControl x:Class="Installer.App.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Installer.App.ViewModels">
    <UserControl.Resources>
        <!-- Shown while logs are decrypted on the worker thread -->
        <Style x:Key="LoadingHint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="Text" Value="Đang tải nhật ký…"/>
            <Setter Property="Visibility" Value="{Binding IsLoadingLogs, Converter={StaticResource BoolToVisibility}}"/>
        </Style>
        <Style x:Key="FilterLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="DangerOutline" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>
        <!-- A verdict cell turns red only when crack is suspected -->
        <Style x:Key="WindowsCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowsWarn}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OfficeCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding OfficeWarn}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: title + vault fingerprint on the left, Back on the right -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Quản trị kho" Style="{StaticResource Title}"/>
                <TextBlock Text="{Binding VaultFingerprint}" Style="{StaticResource Muted}" FontFamily="Consolas"
                           Margin="0,2,0,0"/>
                <Border Background="{StaticResource DangerBgBrush}" Padding="10,6" Margin="0,8,0,0" CornerRadius="4"
                        HorizontalAlignment="Left"
                        Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ReadOnlyBanner}" Style="{StaticResource ErrorText}"/>
                </Border>
                <TextBlock Text="{Binding BusyMessage}" Style="{StaticResource Muted}" Margin="0,6,0,0"
                           Visibility="{Binding BusyMessage, Converter={StaticResource NullToCollapsed}}"/>
                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,6,0,0"
                           Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}"/>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource SuccessBrush}" FontSize="13" Margin="0,6,0,0"
                           Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Quay lại" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}"
                    VerticalAlignment="Top" Padding="14,8"/>
        </Grid>

        <TabControl Grid.Row="1" Style="{StaticResource ReportTabs}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <!-- 0: Gói -->
            <TabItem Header="Gói" Style="{StaticResource ReportTab}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}"
                              AutomationProperties.Name="Danh sách gói trong kho">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="1.5*"/>
                            <DataGridTextColumn Header="Phiên bản" Binding="{Binding Version}" Width="100"/>
                            <DataGridTextColumn Header="Mã gói" Binding="{Binding Id}" Width="1*"/>
                            <DataGridTextColumn Header="Loại" Binding="{Binding InstallerType}" Width="80"/>
                            <DataGridTextColumn Header="Tài liệu" Binding="{Binding DocCount}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Thêm gói..." Command="{Binding AddPackageCommand}" Padding="16,7" Margin="0,0,8,0"/>
                        <Button Content="Cập nhật gói..." Command="{Binding UpdatePackageCommand}" Style="{StaticResource SecondaryButton}"
                                Padding="14,7" Margin="0,0,8,0"/>
                        <CheckBox Content="Giữ phiên bản cũ" IsChecked="{Binding KeepOld}" VerticalAlignment="Center"
                                  Margin="0,0,16,0"/>
                        <Button Content="Xóa gói" Command="{Binding RemovePackageCommand}" Style="{StaticResource DangerOutline}"
                                Padding="14,7"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 1: Bộ gói — list on the left, editor on the right -->
            <TabItem Header="Bộ gói" Style="{StaticResource ReportTab}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="260"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.15*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Các bộ gói" Style="{StaticResource SectionHeading}"
                                       VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="Bộ mới" Command="{Binding NewBundleCommand}"
                                    Style="{StaticResource SecondaryButton}"/>
                        </DockPanel>
                        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <TextBlock Text="Chưa có bộ gói nào. Điền thông tin bên phải rồi bấm Lưu bộ gói."
                                           Margin="14,12" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Bundles.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ListBox ItemsSource="{Binding Bundles}" SelectedItem="{Binding SelectedBundle}"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AutomationProperties.Name="Danh sách bộ gói">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource SubtleBrush}"
                                                                BorderThickness="0,0,0,1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="3"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border x:Name="Edge" Background="Transparent"/>
                                                                <ContentPresenter Grid.Column="1"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#F8F9FB"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                                <Setter TargetName="Edge" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AdminBundleRow}">
                                            <Grid Margin="11,9,12,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ItemsText}" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                                               FontFamily="Consolas" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ItemsText}"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource CountBadge}">
                                                    <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} gói'}" FontSize="12"
                                                               Foreground="{StaticResource MutedBrush}" TextWrapping="NoWrap"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mã bộ gói" Style="{StaticResource FieldLabel}" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Height="34"
                                             VerticalContentAlignment="Center"
                                             AutomationProperties.Name="Mã bộ gói"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tên hiển thị" Style="{StaticResource FieldLabel}" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center"
                                             AutomationProperties.Name="Tên bộ gói"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Mô tả" Style="{StaticResource FieldLabel}" FontSize="13" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                                     AutomationProperties.Name="Mô tả bộ gói"/>
                            <TextBlock Text="Các gói theo thứ tự cài" Style="{StaticResource FieldLabel}" FontSize="13" Margin="0,0,0,2"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                                       Text="Mỗi dòng một mã gói. Thêm @phiên bản để cố định phiên bản, ví dụ 7zip@24.08; bỏ trống để lấy bản mới nhất."/>
                            <TextBox Text="{Binding EditItems, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="150"
                                     FontFamily="Consolas" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"
                                     AutomationProperties.Name="Các gói trong bộ"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Lưu bộ gói" Command="{Binding SaveBundleCommand}" Padding="18,7" Margin="0,0,8,0"/>
                                <Button Content="Xóa bộ gói" Command="{Binding RemoveBundleCommand}" Style="{StaticResource DangerOutline}"
                                        Padding="14,7"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 2: Người dùng -->
            <TabItem Header="Người dùng" Style="{StaticResource ReportTab}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid Grid.Column="0" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" Margin="0,0,20,0"
                              AutomationProperties.Name="Danh sách người dùng">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding Username}" Width="1.5*"/>
                            <DataGridTextColumn Header="Vai trò" Binding="{Binding RoleText}" Width="1*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Tên đăng nhập" Style="{StaticResource FieldLabel}" FontSize="13" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <TextBlock Text="Mật khẩu" Style="{StaticResource FieldLabel}" FontSize="13" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="PwBox" PasswordChanged="PwBox_PasswordChanged" Margin="0,0,0,12"/>
                        <TextBlock Text="Vai trò" Style="{StaticResource FieldLabel}" FontSize="13" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Roles}" SelectedValue="{Binding NewRole}" SelectedValuePath="Role"
                                  DisplayMemberPath="Label" Margin="0,0,0,14"/>
                        <Button Content="Thêm người dùng" Command="{Binding AddUserCommand}" Padding="16,7" Margin="0,0,0,8"/>
                        <Button Content="Đặt lại mật khẩu (người đang chọn)" Command="{Binding ResetPasswordCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="14,7" Margin="0,0,0,8"/>
                        <Button Content="Xóa người dùng" Command="{Binding RemoveUserCommand}" Style="{StaticResource DangerOutline}"
                                Padding="14,7"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 3: Cấu hình quét -->
            <TabItem Header="Cấu hình quét" Style="{StaticResource ReportTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Từ khóa (mỗi dòng một từ)" Style="{StaticResource FieldLabel}" FontSize="13" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding KeywordsText}" AcceptsReturn="True" Height="90"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>
                        <TextBlock Text="Đường dẫn quét (mỗi dòng một đường dẫn)" Style="{StaticResource FieldLabel}" FontSize="13"
                                   Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PathsText}" AcceptsReturn="True" Height="90"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>
                        <TextBlock Text="Số giây tối đa (1 - 3600)" Style="{StaticResource FieldLabel}" FontSize="13" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding MaxSecondsText}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock Text="Dấu hiệu crack (mỗi dòng: loại|biểu thức; loại: kms_host, service, file, hosts_block)"
                                   Style="{StaticResource FieldLabel}" FontSize="13" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SignaturesText}" AcceptsReturn="True" Height="140"
                                 FontFamily="Consolas" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>
                        <Button Content="Lưu cấu hình" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Padding="18,7"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 4: Log -->
            <TabItem Header="Log" Style="{StaticResource ReportTab}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Từ ngày" Style="{StaticResource FilterLabel}"/>
                        <DatePicker SelectedDate="{Binding FromDate}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Đến ngày" Style="{StaticResource FilterLabel}"/>
                        <DatePicker SelectedDate="{Binding ToDate}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Người dùng" Style="{StaticResource FilterLabel}"/>
                        <TextBox Text="{Binding UserFilter, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,14,0"/>
                        <TextBlock Text="Máy" Style="{StaticResource FilterLabel}"/>
                        <TextBox Text="{Binding MachineFilter, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,14,0"/>
                        <Button Content="Tải lại" Command="{Binding LoadLogsCommand}" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"/>
                        <Button Content="Xuất CSV..." Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButton}"/>
                        <TextBlock Style="{StaticResource LoadingHint}"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredLogs}" AutomationProperties.Name="Nhật ký">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Thời gian" Binding="{Binding Ts, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="150"/>
                            <DataGridTextColumn Header="Người dùng" Binding="{Binding Username}" Width="110"/>
                            <DataGridTextColumn Header="Máy" Binding="{Binding Hostname}" Width="110"/>
                            <DataGridTextColumn Header="Hành động" Binding="{Binding Action}" Width="90"/>
                            <DataGridTextColumn Header="Gói" Binding="{Binding PackageId}" Width="100"/>
                            <DataGridTextColumn Header="Phiên bản" Binding="{Binding PackageVersion}" Width="80"/>
                            <DataGridTextColumn Header="Kết quả" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="Chi tiết" Binding="{Binding Detail}" Width="1*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 5: Lịch sử quét (index = AdminViewModel.HistoryTabIndex) -->
            <TabItem Header="Lịch sử quét" Style="{StaticResource ReportTab}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Máy" Style="{StaticResource FilterLabel}"/>
                        <TextBox Text="{Binding MachineFilter, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,14,0"
                                 AutomationProperties.Name="Lọc theo máy"/>
                        <TextBlock Text="Từ ngày" Style="{StaticResource FilterLabel}"/>
                        <DatePicker SelectedDate="{Binding FromDate}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Đến ngày" Style="{StaticResource FilterLabel}"/>
                        <DatePicker SelectedDate="{Binding ToDate}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <Button Content="Tải lại" Command="{Binding LoadLogsCommand}" Style="{StaticResource SecondaryButton}"/>
                        <TextBlock Style="{StaticResource LoadingHint}"/>
                    </WrapPanel>

                    <Grid Grid.Row="1">
                        <TextBlock Text="Không có lần quét nào khớp bộ lọc." Margin="4,40,0,0" FontSize="13"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HistoryCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding HistoryPage}" AutomationProperties.Name="Lịch sử quét"
                                  EnableRowVirtualization="True" RowHeight="38">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HistoryCount}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Thời gian" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:ScanHistoryRow}">
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource CellText}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Máy" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:ScanHistoryRow}">
                                            <TextBlock Text="{Binding Hostname}" Style="{StaticResource CellText}" FontWeight="SemiBold"
                                                       ToolTip="{Binding BiosSerial, StringFormat='Serial BIOS: {0}'}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Người dùng" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:ScanHistoryRow}">
                                            <TextBlock Text="{Binding Username}" Style="{StaticResource CellText}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Windows" Width="1.1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:ScanHistoryRow}">
                                            <TextBlock Text="{Binding WindowsText}" Style="{StaticResource WindowsCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Office" Width="1.1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:ScanHistoryRow}">
                                            <TextBlock Text="{Binding OfficeText}" Style="{StaticResource OfficeCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:ScanHistoryRow}">
                                            <Button Content="Xem báo cáo" Style="{StaticResource SecondaryButton}" Padding="10,3"
                                                    Margin="0,0,8,0" VerticalAlignment="Center"
                                                    AutomationProperties.Name="{Binding Hostname, StringFormat='Xem báo cáo quét của {0}'}"
                                                    Command="{Binding DataContext.OpenScanCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding Item}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Footer: result count left, pager right -->
                    <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                   Text="{Binding HistoryCount, StringFormat='{}{0} lần quét'}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Trang trước" Command="{Binding PrevPageCommand}" Style="{StaticResource SecondaryButton}"/>
                            <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Margin="12,0" FontSize="13"
                                       TextWrapping="NoWrap"/>
                            <Button Content="Trang sau" Command="{Binding NextPageCommand}" Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
