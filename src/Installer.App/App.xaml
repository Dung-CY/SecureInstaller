<Application x:Class="Installer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Installer.App.Converters"
             Startup="OnStartup" Exit="OnExit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:NullToCollapsed x:Key="NullToCollapsed"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:FileNamePart x:Key="FileNamePart"/>
            <conv:IconConverter x:Key="PackageIcon" Fallback="{StaticResource DefaultPackageIcon}"/>
            <conv:IconConverter x:Key="InstalledIcon" DecodeSize="40"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
